# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 선택 — Gemini (실제 호출은 Node dev-server 에서만)
# 키는 painpoint/config.js 의 geminiApiKey 또는 openaiApiKey(호환) 에 두면 됩니다.
# 로컬: npm run dev:ssatis 또는 node painpoint/dev-server.mjs → http://localhost:8787/
GEMINI_API_KEY=AIza...
# 모델 변경 예: GEMINI_MODEL=gemini-1.5-flash

# Vercel 배포 시 Settings → Environment Variables 에 반드시 설정:
#   GEMINI_API_KEY, YOUTUBE_API_KEY (유튜브 수집 시)
#   GOOGLE_CLIENT_ID (Google 로그인 GIS)
#   SUPABASE_URL, SUPABASE_ANON_KEY (Supabase OAuth / DB)
#
# 위 값을 복사해서 config.js 에도 동일하게 입력하세요 (로컬 UI 표시용).
# 템플릿: painpoint/config.example.js
